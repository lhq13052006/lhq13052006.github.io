  <tr>
    <td colspan="2" class="banner">
      <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr>
          <td width="40%"><img src="../Images/Logo.gif" width="343" height="68" /></td>
          <td width="60%" class="chubanner"><a href="#">HELP</a> | <a href="#">SUPPORT</a> | <a href="#">SEARCH</a></td>
        </tr>
      </table>
    </td>
  </tr>
  
  <tr>
    <td colspan="2" bgcolor="#E68B00">
      <img src="../Images/corner.gif" width="185" height="26" style="display:block; float:left;" /><a href="../index.html"><img src="../Images/home_up.gif" width="91" height="26" id="Image1" onmouseover="MM_swapImage('Image1','','../Images/home_over.gif',1)" onmouseout="MM_swapImgRestore()" style="display:block; float:left;" /></a><a href="../aboutus.html"><img src="../Images/about_up.gif" width="131" height="26" id="Image2" onmouseover="MM_swapImage('Image2','','../Images/about_over.gif',1)" onmouseout="MM_swapImgRestore()" style="display:block; float:left;" /></a><a href="../products.html"><img src="../Images/Product_up.gif" width="134" height="26" id="Image3" onmouseover="MM_swapImage('Image3','','../Images/Product_over.gif',1)" onmouseout="MM_swapImgRestore()" style="display:block; float:left;" /></a><a href="../links.html"><img src="../Images/link_up.gif" width="109" height="26" id="Image4" onmouseover="MM_swapImage('Image4','','../Images/link_over.gif',1)" onmouseout="MM_swapImgRestore()" style="display:block; float:left;" /></a><a href="../contact.html"><img src="../Images/contact_up.gif" width="129" height="26" id="Image5" onmouseover="MM_swapImage('Image5','','../Images/contact_over.gif',1)" onmouseout="MM_swapImgRestore()" style="display:block; float:left;" /></a>
    </td>
  </tr>
  
  <tr>
    <td width="185" height="486" class="back">
      <img src="../Images/spotlight.gif" width="185" height="108" style="display: block;" />
      
      <img src="../Images/Genre.gif" width="185" height="28" alt="Genre" style="display: block;" />
      <ul class="custom-menu">
        <li>Business</li>
        <li>Vibes</li>
        <li>Urban Grooves</li>
        <li>Party Zone</li>
      </ul>

      <img src="../Images/Format.gif" width="185" height="28" alt="Format" style="display: block;" />
      <ul class="custom-menu">
        <li>Loops</li>
        <li>Intros</li>
        <li>Tracks</li>
        <li>Construction Kits</li>
      </ul>

      <img src="../Images/Overview.gif" width="185" height="28" alt="Overview" style="display: block;" />
      <ul class="custom-menu">
        <li>Your Cart</li>
        <li>Your Account</li>
        <li>Check Out</li>
        <li>Contact Us</li>
      </ul>
    </td>
    <td width="595" bgcolor="#FFFFFF" valign="top"><!-- TemplateBeginEditable name="noidung" -->noidung<!-- TemplateEndEditable --></td>
  </tr>
  
  <tr>
    <td colspan="2" bgcolor="#FFFFFF">
